# app.kv
#:import TopUtilityBar app.widgets.TopUtilityBar
#:import ControlPad app.widgets.ControlPad
#:import TelemetryDashboard app.widgets.TelemetryDashboard

FloatLayout:
    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.1, 1 # Deep Space Blue base
        Rectangle:
            pos: self.pos
            size: self.size

    # Layer 0: The Reactive Background
    # (Assuming you have a Lottie widget or Image here)
    FitImage:
        source: "app/assets/images/image.jpg"
        fit_mode: "fill"
        opacity: 0.4
        canvas.after:
            Color:
                rgba: 1, 0.8, 0.9, 0.6
            Mesh:
                mode: 'triangle_fan'
                # (x, y, u, v)
                vertices: [self.x, self.y, 0, 0, self.x + 250, self.y, 0, 0, self.x + 250, self.y + 10, 0, 0, self.x, self.y + 200, 0, 0]
                indices: [0, 1, 2, 3, 4]

            # --- RIGHT FOOTER "WING" ---
            Mesh:
                mode: 'triangle_fan'
                vertices: [self.right, self.y, 0, 0, self.right - 250, self.y, 0, 0, self.right - 250, self.y + 10, 0, 0, self.right, self.y + 200, 0, 0]
                indices: [0, 1, 2, 3, 4]
            
            Mesh:
                mode: 'triangle_fan'
                vertices: [self.center_x - 145, self.y + 10, 0, 0, self.center_x - 115, self.y + 25, 0, 0, self.center_x + 115, self.y + 25, 0, 0, self.center_x + 145, self.y + 10, 0, 0]
                indices: [0, 1, 2, 3, 4]

            Mesh:
                mode: 'triangle_fan'
                vertices: [self.x + 250, self.y, 0, 0, self.x + 250, self.y + 10, 0, 0, self.right - 250, self.y + 10, 0, 0, self.right - 250, self.y, 0, 0]
                indices: [0, 1, 2, 3, 4]

            # --- BOTTOM HUD BRACKET (Center Line) ---
            Color:
                rgba: 1, 0.8, 0.6, 0.9
            Line:
                points: [self.x + 15, self.y + 200, self.x + 260, self.y + 18, self.center_x - 150, self.y + 18, self.center_x - 120, self.y + 32, self.center_x + 120, self.y + 32, self.center_x + 150, self.y + 18, self.right - 260, self.y + 18, self.right - 15, self.y + 200]
                width: 1.5   

    # Layer 1: Central Telemetry (Speed & Mission Time)
    TelemetryDashboard:
        id: telemetry_hud
        pos_hint: {"center_x": 0.5, "center_y": 0.55}

    # Layer 2: Top Utility Bar (Wifi, Distance, Mic)
    TopUtilityBar:
        id: top_nav
        pos_hint: {"top": 1}

    # Layer 3: Controls (Drive, Steering, Boost)
    # Positioned slightly higher to stay clear of the Footer
    ControlPad:
        id: drive_controls
        pos_hint: {"center_x": 0.5, "center_y": 0.55}

    