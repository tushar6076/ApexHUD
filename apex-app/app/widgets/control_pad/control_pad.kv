# app/widgets/control_pad/control_pad.kv

<ControlPad>:
    # --- LEFT SIDE: DRIVE (Forward/Backward) ---
    RelativeLayout:
        size_hint: None, None
        size: "180dp", "180dp"
        pos_hint: {"center_x": 0.15, "center_y": 0.35}
        
        canvas.before:
            # 1. Outer Neon Glow Ring
            Color:
                rgba: 1, 0.8, 0, 0.3 # Yellow Neon
            Line:
                circle: (self.width / 2, self.height / 2, 100)
                width: 2.5
            
            # 2. Inner Grid/Joystick Circle
            Color:
                rgba: 1, 0.8, 0, 0.1
            Ellipse:
                pos: (self.width / 2 - 60, self.height / 2 - 60)
                size: (120, 120)

            # 3. Center Control Dot
            Color:
                rgba: 1, 0.8, 0, 0.8
            Ellipse:
                pos: (self.width / 2 - 10, self.height / 2 - 10)
                size: (20, 20)

        # Directional Overlays
        MDIconButton:
            icon: "chevron-up"
            pos_hint: {"center_x": 0.5, "center_y": 0.63}
            theme_text_color: "Custom"
            text_color: 1, 0.8, 1, 1
            on_press: root.send_command("F")
            on_release: root.send_command("H")

        MDIconButton:
            icon: "chevron-down"
            pos_hint: {"center_x": 0.5, "center_y": 0.37}
            theme_text_color: "Custom"
            text_color: 1, 0.8, 1, 1
            on_press: root.send_command("B")
            on_release: root.send_command("H")

    # --- RIGHT SIDE: STEERING (Left/Right) ---
    RelativeLayout:
        size_hint: None, None
        size: "180dp", "180dp"
        pos_hint: {"center_x": 0.85, "center_y": 0.35}

        canvas.before:
            # 1. Outer Neon Glow Ring
            Color:
                rgba: 1, 0.8, 0, 0.3
            Line:
                circle: (self.width / 2, self.height / 2, 100)
                width: 2.5

            # 2. Inner Circle
            Color:
                rgba: 1, 0.8, 0, 0.1
            Ellipse:
                pos: (self.width / 2 - 60, self.height / 2 - 60)
                size: (120, 120)

            # 3. Center Control Dot
            Color:
                rgba: 1, 0.8, 0, 0.8
            Ellipse:
                pos: (self.width / 2 - 10, self.height / 2 - 10)
                size: (20, 20)

        MDIconButton:
            icon: "chevron-left"
            pos_hint: {"center_x": 0.37, "center_y": 0.5}
            theme_text_color: "Custom"
            text_color: 1, 0.8, 1, 1
            on_press: root.send_command("L")
            on_release: root.send_command("H")

        MDIconButton:
            icon: "chevron-right"
            pos_hint: {"center_x": 0.63, "center_y": 0.5}
            theme_text_color: "Custom"
            text_color: 1, 0.8, 1, 1
            on_press: root.send_command("R")
            on_release: root.send_command("H")

    # --- FUNCTION BUTTONS ---

    # Horn (Near Center Left)
    MDIconButton:
        icon: "bullhorn"
        pos_hint: {"center_x": 0.35, "center_y": 0.25}
        icon_size: "32sp"
        theme_text_color: "Custom"
        text_color: 1, 0.8, 0, 1
        on_press: root.horn(self)
        canvas.before:
            Color:
                rgba: 1, 0.8, 0, 0.5
            Line:
                circle: (self.center_x, self.center_y, 45) 
                width: 2.7
            Color:
                rgba: 1, 0.8, 0, 0.2
            Ellipse:
                pos: (self.center_x - 38, self.center_y - 38)
                size: (76, 76)

    # HEADLIGHTS (Near Center Right)
    MDIconButton:
        id: light_btn
        icon: "car-light-dimmed"
        pos_hint: {"center_x": 0.65, "center_y": 0.25}
        icon_size: "32sp"
        theme_text_color: "Custom"
        text_color: 1, 0.8, 0, 1
        on_release: root.toggle_headlight(self)
        canvas.before:
            Color:
                rgba: (1, 0.8, 0, 0.5) if not root.light_active else (1, 0.8, 0.8, 0.5)
            Line:
                circle: (self.center_x, self.center_y, 45) 
                width: 2.7 if not root.light_active else 4.5
            Color:
                rgba: (1, 0.8, 0, 0.2) if not root.light_active else (1, 0.8, 0.8, 0.4)
            Ellipse:
                pos: (self.center_x - 38, self.center_y - 38)
                size: (76, 76)