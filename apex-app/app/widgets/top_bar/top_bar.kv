<TopUtilityBar>:
    orientation: 'horizontal'
    padding: [0, 0]
    size_hint_y: None
    height: "70dp"

    canvas.before:
        # HUD Brackets
        Color:
            rgba: 1, 0.8, 0, 0.4
        Line:
            points: [self.x + 20, self.top - 10, self.x + 140, self.top - 10, self.x + 195, self.top - 75, self.x + 600, self.top - 75]
            width: 1.5
        Line:
            points: [self.right - 20, self.top - 10, self.right - 140, self.top - 10, self.right - 195, self.top - 75, self.right - 600, self.top - 75]
            width: 1.5

    # --- LEFT GROUP (Pinned Left) ---
    BoxLayout:
        size_hint_x: None
        width: "300dp"
        spacing: "40dp"
        padding: ["20dp", 0, 0, 0]
        
        MDIconButton:
            id: wifi_btn
            # FIXED: Show 'wifi-check' when connected, 'wifi-sync' when offline
            icon: "wifi-check" if app.is_connected else "wifi-sync"
            ripple_scale: .85
            theme_text_color: "Custom"
            # FIXED: Cyan when connected, Orange/Red when offline
            text_color: (0, 1, 1, 1) if app.is_connected else (1, 0.4, 0, 1)
            pos_hint: {"center_y": .65}
            on_release: root.open_connection_dialog()
            canvas.before:
                Color:
                    rgba: (0, 1, 1, 0.15) if app.is_connected else (1, 0.4, 0, 0.1)
                Ellipse:
                    pos: self.x + 5, self.y + 5
                    size: self.width - 10, self.height - 10
                    
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: "110dp"
            spacing: "5dp"
            pos_hint: {"center_y": .65}
            
            MDIcon:
                icon: "map-marker-distance"
                theme_text_color: "Custom"
                text_color: 1, 0.8, 0, 1
                font_size: "18sp"
                pos_hint: {"center_y": .5} 

            MDLabel:
                text: root.distance_text
                font_name: "Orbitron"
                font_size: "14sp"
                theme_text_color: "Primary"
                pos_hint: {"center_y": .5}
                size_hint_y: None
                height: self.texture_size[1]

    Widget: # Expanding Center Spacer

    # --- RIGHT GROUP (Pinned Right) ---
    BoxLayout:
        size_hint_x: None
        width: "300dp"
        spacing: "40dp"
        padding: [0, 0, "20dp", 0]
        
        Widget: 
            size_hint_x: 1 

        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: "110dp"
            spacing: "5dp"
            pos_hint: {"center_y": .65}
            MDLabel:
                text: root.battery_percent
                font_name: "Orbitron"
                font_size: "11sp"
                halign: "right"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                pos_hint: {"center_y": .5}
                size_hint_y: None
                height: self.texture_size[1]

            MDIcon:
                icon: "battery-outline"
                font_size: "18sp"
                theme_text_color: "Custom"
                text_color: 0.6, 1, 0.2, 1 
                pos_hint: {"center_y": .5} 

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: None
            height: "180dp"
            spacing: "4dp"
            pos_hint: {"center_y": .1}
            
            MDIconButton:
                id: speaker
                icon: "volume-high"
                ripple_scale: .85
                pos_hint: {"center_x": .5}
                theme_text_color: "Custom"
                text_color: 0.8, 1, 1, 1
                on_press: root.speaker_transmission()
                canvas.before:
                    Color:
                        rgba: 0.8, 1, 1, 0.1
                    Ellipse:
                        pos: self.x + 5, self.y + 5
                        size: self.width - 10, self.height - 10
            
            MDIconButton:
                id: mic_btn
                icon: "microphone-off"
                ripple_scale: .85
                pos_hint: {"center_x": .5}
                theme_text_color: "Custom"
                text_color: 1, 0, 0, 1
                on_press: root.mic_transmission()
                canvas.before:
                    Color:
                        rgba: 0.4, 0.7, 1, 0.1
                    Ellipse:
                        pos: self.x + 5, self.y + 5
                        size: self.width - 10, self.height - 10