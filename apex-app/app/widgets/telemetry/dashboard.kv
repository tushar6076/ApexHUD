# app/widgets/telemetry/dashboard.kv

<TelemetryDashboard>:
    # --- MISSION CLOCK (Top Center) ---
    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        size: "200dp", "60dp"
        pos_hint: {"center_x": 0.5, "top": 0.95}

        MDLabel:
            text: root.mission_time
            font_name: "Orbitron"
            font_size: "18sp"
            halign: "center"
            theme_text_color: "Custom"
            text_color: 1, 0.8, 0, 1 # Gold/Yellow
            canvas.before:
                Color:
                    rgba: 1, 0.8, 0, 0.5
                Line:
                    # Ensure points are also clean
                    points: [self.center_x-400, self.center_y+30, self.center_x-300, self.center_y-30, self.center_x+300, self.center_y-30, self.center_x+400, self.center_y+30]
                    width: 1.5


    # --- MAIN SPEEDOMETER (Center) ---
    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        size: "200dp", "120dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

        MDLabel:
            text: root.speed_text
            font_name: "Orbitron"
            font_size: "70sp"
            halign: "center"
            theme_text_color: "Primary"

        MDLabel:
            text: "KM/H"
            font_name: "Orbitron"
            font_size: "14sp"
            halign: "center"
            theme_text_color: "Secondary"